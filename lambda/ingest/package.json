{
  "name": "ingest-function",
  "version": "1.0.0",
  "private": true,
  "description": "Handler for the Step 2 ingest Lambda, packaged as a container image. Self-contained on purpose: its dependencies are not shared with the CDK app's own package.json.",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild index.ts --bundle --platform=node --target=node22 --minify --outfile=index.js",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "typescript": "^5.9.3"
  }
}
